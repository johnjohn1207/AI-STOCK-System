# Supabase / PostgreSQL (preferred)
DATABASE_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres

# Or use these individual variables instead
DB_USER=postgres
DB_PASSWORD=replace_me
DB_HOST=replace_me
DB_PORT=5432
DB_NAME=postgres

# Railway
PORT=8000

# Production frontend origin(s), comma-separated
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:3000

# Next.js (frontend/.env.local or Vercel environment)
NEXT_PUBLIC_API_URL=https://your-railway-api.up.railway.app
